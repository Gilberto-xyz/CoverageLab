### Cómo permitir archivos puntuales
# Para incluir un archivo adicional (ej. rar/zip/pdf o un script nuevo),
# agrégalo explícitamente aquí con una excepción usando '!':
#   !ruta/al/archivo.rar
#   !ruta/al/archivo.zip
#   !ruta/al/archivo.pdf
#   !ruta/al/script_extra.py

# Nota: los Excel u otros binarios quedan ignorados por defecto a menos que se declaren

# Las excepciones por nombre nunca deben incluir datos, capturas ni entregas.
/recursos/Output/
/recursos/outputs/
/recursos/inputs/
!scripts/project_paths.py
!scripts/preparar_proyecto.py
!scripts/tests/test_project_preparation.py
!scripts/ejecutar_pruebas.py
!scripts/tests/test_repository_layout.py
/recursos/.estado/
/recursos/**/__pycache__/
/recursos/**/*.pyc
/.reorganizacion/

/scripts/outputs/
/scripts/**/__pycache__/
/scripts/**/*.pyc

